# Copy to scripts/.env and edit. Lines starting with # are ignored. Never commit scripts/.env.

# 0 = build on this computer only: the PDF and web page go to the Desktop folder below and to
#     market-report/ inside the repository, nothing is published. (default)
# 1 = also commit the new report and push it to GitHub so GitHub Pages publishes it. Before switching
#     this on, remove the three "market-report/..." lines from .gitignore so the files can be committed.
REPORT_PUSH=0

# Where finished reports are copied for you (one PDF + one HTML per trading day).
# Default: a folder called "The Ticker Market Reports" on your Desktop. Set a path to change it,
# or 0 to switch the copy off.
REPORT_EXPORT_DIR=

# Extra folders that ALSO receive a copy of every report, separated by ; — for example an external SSD:
#   macOS    REPORT_COPY_DIRS=/Volumes/MySSD/The Ticker Market Reports
#   Windows  REPORT_COPY_DIRS=E:\The Ticker Market Reports
# A drive that is not connected at run time is skipped and the missing reports are copied on the next
# run with the drive connected. The menu (choice F) fills this in for you and copies at once.
REPORT_COPY_DIRS=

# Name/e-mail used for the automatic commits (optional)
GIT_AUTHOR_NAME=the-ticker-bot
GIT_AUTHOR_EMAIL=the-ticker-bot@users.noreply.github.com

# Optional e-mail delivery (PDF attached, one-minute summary in the body).
# Leave REPORT_SMTP_HOST empty to skip. Recipients: list them here separated by commas, and/or
# one per line in scripts/recipients.txt (the menu can manage that file for you).
#
# Gmail (most common):
#   1. Turn on 2-Step Verification at https://myaccount.google.com/security
#   2. Create an App Password at https://myaccount.google.com/apppasswords (name it "The Ticker")
#   3. Use the 16-character password below. Your normal Gmail password will NOT work.
#   REPORT_SMTP_HOST=smtp.gmail.com   REPORT_SMTP_PORT=587   REPORT_SMTP_USER=you@gmail.com
# Microsoft 365 / Outlook work account: smtp.office365.com, port 587, your e-mail and password
#   (your IT admin must have SMTP AUTH enabled for the mailbox).
REPORT_SMTP_HOST=
REPORT_SMTP_PORT=587
REPORT_SMTP_USER=
REPORT_SMTP_PASS=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
# 1 = if the exchange's own Market Report is not out yet at run time, e-mail the preliminary edition
#     (clearly labelled) and the final edition later; 0 = wait and e-mail only the final edition.
REPORT_EMAIL_PRELIMINARY=1
