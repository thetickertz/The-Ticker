# Copy to scripts/.env and edit. Lines starting with # are ignored. Never commit scripts/.env.

# 1 = commit the new report and push it to GitHub (GitHub Pages then publishes it).
# 0 = only write the files to market-report/ on this computer.
REPORT_PUSH=1

# Name/e-mail used for the automatic commits (optional)
GIT_AUTHOR_NAME=the-ticker-bot
GIT_AUTHOR_EMAIL=the-ticker-bot@users.noreply.github.com

# Optional e-mail distribution (PDF attached, one-minute summary in the body).
# Leave REPORT_SMTP_HOST empty to skip. Gmail: smtp.gmail.com, port 587, an App Password.
# Microsoft 365: smtp.office365.com, port 587, SMTP AUTH enabled on the mailbox.
REPORT_SMTP_HOST=
REPORT_SMTP_PORT=587
REPORT_SMTP_USER=
REPORT_SMTP_PASS=
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
